# Frontend Environment Variables
# Copy this file to .env.local for local development

# Backend API URL (must include /api suffix)
# Development: Leave unset (uses /api proxy to localhost:8000)
# Production: Set to your deployed backend URL + /api
# Example: NEXT_PUBLIC_API_BASE_URL=https://agent-issue-tracking.onrender.com/api
NEXT_PUBLIC_API_BASE_URL=

# Supabase Auth (Project Settings > API). The anon key is public by design.

NEXT_PUBLIC_SUPABASE_URL=https://euhafvxclmmzkmexbcyf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_OZlURSrai6pEaCvKv6zR2g_GN-Kdyf_
