{
  "name": "issue-tracking-monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,green \"cd frontend && next dev\" \"python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload\"",
    "dev:frontend": "cd frontend && next dev",
    "dev:backend": "python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload",
    "build": "cd frontend && next build",
    "start": "cd frontend && next start"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "mini-svg-data-uri": "^1.4.4",
    "motion": "^12.42.2",
    "next": "^16.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^8.0.0",
    "eslint": "^10.5.0",
    "eslint-config-next": "^16.2.0",
    "typescript": "^5.6.3"
  }
}
