# Database
# Supabase Postgres connection string (Settings > Database > Connection string, URI format)
# Use the direct/session connection (not the transaction-mode pooler) for SQLAlchemy compatibility
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Optional: Separate database for tests (falls back to DATABASE_URL if not set)
# TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# AI Services
# OpenAI API key for embeddings (text-embedding-3-small) and LLM calls (GPT-4)
OPENAI_API_KEY=sk-...

# Optional: Override discovery agent model (default: gpt-4o)
# Options: gpt-4o (recommended), gpt-4-turbo, gpt-4o-mini (fast but less intelligent)
# OPENAI_DISCOVERY_MODEL=gpt-4o

# Tavily API key for web search
TAVILY_API_KEY=tvly-...

# Perplexity API key for research with citations (optional but recommended for quality)
# PERPLEXITY_API_KEY=pplx-...
